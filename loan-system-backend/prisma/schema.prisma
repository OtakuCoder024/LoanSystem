generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String
  role     String @default("USER")
  
  loans    Loan[]
}

model Loan {
  id       Int     @id @default(autoincrement())
  amount   Int
  term     Int
  rate     Float
  monthly  Float   
  total    Float  
  status   String  @default("PENDING")

  userId   Int
  user     User    @relation(fields: [userId], references: [id])
}